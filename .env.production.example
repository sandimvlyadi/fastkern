# Production settings for docker-compose.prod.yml. Copy to .env.production on the server, fill in
# every CHANGE-ME and keep the file readable by root only (chmod 600): it holds the secrets.
# ENVIRONMENT, DATABASE_URL, REDIS_URL and the Celery URLs are set by the compose file from the
# values below; don't set them here.

# --- Deployment (read by docker compose itself) ---
# A release tag or, better, the digest from the publish workflow's summary. Never `latest`.
# EMAIL_CONSOLE_IN_PRODUCTION below needs a release newer than 0.3.0.
FASTKERN_IMAGE=ghcr.io/sandimvlyadi/fastkern:X.Y.Z
# Public host name nginx serves and requests the certificate for.
SERVER_NAME=api.example.com
# Where certbot keeps certificates and writes ACME challenges on the host.
# TLS_CERT_DIR=/etc/letsencrypt
# ACME_WEBROOT=/var/www/certbot
# The nginx <-> api network. The api trusts X-Forwarded-For only from NGINX_EDGE_IP (uvicorn's
# FORWARDED_ALLOW_IPS is set from it), so change both together if this range is taken on the host.
# EDGE_SUBNET=172.30.10.0/24
# NGINX_EDGE_IP=172.30.10.10

# --- Datastores ---
# Hex only: both end up inside connection URLs, where other characters would need escaping.
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=CHANGE-ME-postgres-password-hex
REDIS_PASSWORD=CHANGE-ME-redis-password-hex

# --- App ---
APP_NAME=fastkern
DEBUG=false
API_V1_PREFIX=/api/v1
# DOCS_ENABLED=true                 # /docs, /redoc and /openapi.json are off in production

# --- Security ---
# The app refuses to start with a placeholder or short key. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-run-the-command-above
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080   # 7 days
JWT_ALGORITHM=HS256

# --- CORS ---
# The browser origins of your frontends. `*` is refused in production.
CORS_ORIGINS=["https://app.example.com"]

# --- Database pool ---
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Observability ---
ENABLE_TRACING=false
ENABLE_METRICS=true
# nginx already blocks /metrics; the token also protects it from other containers. Generate it the
# same way as SECRET_KEY. Unset logs `metrics_endpoint_unauthenticated` at startup.
METRICS_AUTH_TOKEN=CHANGE-ME-metrics-scrape-token
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=fastkern

# --- i18n / timezone ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","id"]
DEFAULT_TIMEZONE=UTC

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP=300/minute
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WRITE=30/minute
RATE_LIMIT_UPLOAD=600/minute

# --- Multi-tenancy ---
MULTI_TENANCY_ENABLED=true
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Email ---
# smtp or http with the provider's credentials. `console` sends nothing and only logs the masked
# recipient and subject; production accepts it only with EMAIL_CONSOLE_IN_PRODUCTION=true, and
# logs `email_not_delivered` at startup while it is on.
EMAIL_BACKEND=console
EMAIL_CONSOLE_IN_PRODUCTION=true
EMAIL_FROM=no-reply@example.com
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=CHANGE-ME
# SMTP_PASSWORD=CHANGE-ME
# SMTP_STARTTLS=true                # STARTTLS or SMTP_SSL (implicit TLS), not both
# SMTP_SSL=false

# --- File storage & uploads ---
STORAGE_ROOT=data
UPLOAD_CHUNK_MAX_BYTES=20971520      # 20 MiB; nginx's client_max_body_size (25m) must stay above it
UPLOAD_MAX_FILE_BYTES=1073741824     # 1 GiB
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_MAX_ACTIVE_SESSIONS_PER_USER=5
AVATAR_MAX_BYTES=5242880
# none logs `uploads_not_malware_scanned` at startup. clamav needs `--profile clamav`.
MALWARE_SCAN_BACKEND=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILES_CLEANUP_INTERVAL_SECONDS=900

# --- Seed (`run --rm seed`, once) ---
# Production refuses the public default and anything shorter than 12 characters.
SEED_DEFAULT_PASSWORD=CHANGE-ME-at-least-12-chars
SEED_DEVELOPER_EMAIL=developer@example.com
