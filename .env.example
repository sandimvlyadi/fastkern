# --- App ---
ENVIRONMENT=local                # local | test | staging | production
APP_NAME=fastkern
APP_VERSION=0.2.0
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Placeholder for local dev only: ENVIRONMENT=staging|production REFUSES TO START with it (or with
# any short/repetitive key). Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-byte-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080   # 7 days
JWT_ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastkern
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=fastkern
ENABLE_TRACING=false
ENABLE_METRICS=true

# --- i18n / timezone ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","id"]
DEFAULT_TIMEZONE=UTC

# --- Rate limiting ---
# Set RATE_LIMIT_ENABLED=false for load tests / local experiments. /healthz,
# /readyz, /metrics and /docs are never rate limited either way.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP=300/minute         # every API endpoint, per client IP, checked before auth
RATE_LIMIT_DEFAULT=100/minute    # every API endpoint, per user (per IP before login)
RATE_LIMIT_AUTH=10/minute        # register / login / refresh, per IP
RATE_LIMIT_WRITE=30/minute       # POST/PATCH/DELETE on top of the default limit

# --- Multi-tenancy ---
MULTI_TENANCY_ENABLED=true
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Health checks ---
READINESS_CHECK_TIMEOUT_SECONDS=3.0
# beat runs `ops.heartbeat` at this interval; /readyz reports beat (and clamav when it is the
# scan backend) from its Redis keys, which expire after 3 intervals. Informational only: a stale
# heartbeat is reported but never makes /readyz fail.
OPS_HEARTBEAT_INTERVAL_SECONDS=60.0

# --- Email (welcome emails etc., sent from the Celery worker) ---
# console = only log (local default); smtp = stdlib client; http = provider API.
# ENVIRONMENT=production refuses "console" and requires the matching credentials below.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
# SMTP_HOST=localhost
# SMTP_PORT=1025                    # mailpit's SMTP port
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false               # STARTTLS or SMTP_SSL (implicit TLS), not both
# SMTP_SSL=false
# SMTP_TIMEOUT_SECONDS=10
# EMAIL_HTTP_BASE_URL=
# EMAIL_HTTP_API_KEY=
# Protect /metrics with `Authorization: Bearer <token>` (unset = open, fine locally only):
# METRICS_AUTH_TOKEN=

# Posts module — demo external API (JSONPlaceholder). The auth token is a placeholder;
# JSONPlaceholder ignores it, but a real partner API would check it the same way.
# POSTS_API_BASE_URL=https://jsonplaceholder.typicode.com
# POSTS_API_TIMEOUT_SECONDS=5
# POSTS_API_AUTH_HEADER=Authorization
# POSTS_API_AUTH_TOKEN=dummy-posts-api-token

# --- File storage & uploads (files module) ---
# Local filesystem root: tmp/ (chunks), private/ and public/. Shared by api, worker and beat.
STORAGE_ROOT=data
UPLOAD_CHUNK_MAX_BYTES=20971520      # 20 MiB per request/chunk
UPLOAD_MAX_FILE_BYTES=1073741824     # 1 GiB total per file, independent of the chunk size
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_MAX_ACTIVE_SESSIONS_PER_USER=5
AVATAR_MAX_BYTES=5242880             # 5 MiB cap for user avatar uploads (users module, via files)
IMAGE_VARIANT_SIZES=[128,256,512]
IMAGE_MAX_DIMENSION=4096
IMAGE_QUALITY=80
IMAGE_MAX_PIXELS=40000000
# Malware scanning is optional. "clamav" needs the `clamav` compose profile.
MALWARE_SCAN_BACKEND=none            # none | clamav (api and worker must agree)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
RATE_LIMIT_UPLOAD=600/minute         # chunk PUTs
# Cleanup schedule (beat). 900 is for deployments; use a small value only for local testing.
FILES_CLEANUP_INTERVAL_SECONDS=900

# --- Seed data (used by `make seed` / `make docker-seed`) ---
# Local/test may use these public defaults. staging/production REFUSE them: there
# SEED_DEFAULT_PASSWORD (>= 12 chars) and SEED_DEVELOPER_EMAIL must be set explicitly.
SEED_DEFAULT_PASSWORD=ChangePlease123!
SEED_DEVELOPER_EMAIL=developer@example.com
