# Rendered by the nginx image at start into /etc/nginx/conf.d/default.conf. Only environment
# variables that exist in the container are substituted (${SERVER_NAME}); nginx's own variables
# such as $host stay as they are.

# Docker's embedded DNS. `resolve` re-reads the api's address while nginx runs: a rollout
# recreates the api container with a new IP, and a name resolved only at start would then 502 for
# good. While the api is being recreated its name doesn't resolve; nginx answers 502 until the next
# lookup after it is back, so `valid` bounds that gap.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream fastkern_api {
    zone fastkern_api 64k;
    server api:8000 resolve;
    keepalive 16;
}

# A request for any other host name (a scanner hitting the bare IP) gets no answer.
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # certbot --webroot renewals.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;

    # One upload chunk is up to 20 MiB (UPLOAD_CHUNK_MAX_BYTES), plus headers. Raise both together.
    client_max_body_size 25m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # Prometheus scrapes the api over the container network; the internet never sees /metrics.
    location = /metrics {
        return 404;
    }

    # Readiness names the dependency that is down; check it from the host instead. /healthz stays
    # public for uptime monitors.
    location = /readyz {
        return 404;
    }

    # The api sets HSTS and the other security headers itself, so they are not repeated here.
    location / {
        proxy_pass http://fastkern_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwritten, not appended: a client-sent X-Forwarded-For must not reach the api, which
        # trusts this header from nginx to rate limit per client IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
